{
  "name": "bjj-goal-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BJJ goal tracker — set goals, log mat time, watch the belt fill in.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node --env-file-if-exists=.env.development.local server/index.js",
    "start": "npm run build && node --env-file-if-exists=.env.development.local server/index.js",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/migrate-db.js"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^3.23.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
